# Farm Alert Performance — environment variables. Copy to .env.local for
# development; set the real values in the Vercel project. Never commit
# real values.

# Supabase: the SAME project VetXpress uses (shared perf_* tables, staff
# logins). Service role key is server-only and bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs this app's 30-day session cookie. Generate a long random value,
# e.g. `openssl rand -base64 48`. Its own secret, not VetXpress's.
PERF_APP_SESSION_SECRET=

# ERPNext, READ-ONLY API user (figures and auto-ticks). This app never
# writes to ERPNext.
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Shared secret for the 15-minute tick (/api/cron/tick), sent as the
# x-cron-secret header by the VPS crontab.
CRON_SECRET=

# Optional: Web Push reminders. `npx web-push generate-vapid-keys`.
# Unset = reminders show in the app's notification list only.
PERF_PUSH_VAPID_PUBLIC_KEY=
PERF_PUSH_VAPID_PRIVATE_KEY=
PERF_PUSH_VAPID_SUBJECT=mailto:tech@farmalert.com.ng
